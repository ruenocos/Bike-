[gd_resource type="Theme" format=3]

; Panzer Pop UI theme (v0.31). Palette:
;   ink     #141416  Color(0.078, 0.078, 0.086)
;   paper   #F4F1E8  Color(0.957, 0.945, 0.91)
;   red     #E5322D  Color(0.898, 0.196, 0.176)
;   mustard #F2B705  Color(0.949, 0.718, 0.02)
;   olive   #3E5B3A  Color(0.243, 0.357, 0.227)
;   navy    #1B2340  Color(0.106, 0.137, 0.251)
; Every "tape" is a StyleBoxFlat with skew 0.28: the box leans like the
; italic text, the text itself stays upright (Godot draws text unskewed).
; Fonts (OFL, ui/fonts/): Big Shoulders Stencil Display Black (numbers,
; headlines), Barlow Condensed Italic (labels, buttons), Barlow SemiBold
; (body copy), Dela Gothic One (katakana / kanji accents).

[ext_resource type="FontFile" path="res://ui/fonts/BigShouldersStencilDisplay-Black.ttf" id="1_stencil"]
[ext_resource type="FontFile" path="res://ui/fonts/BarlowCondensed-BlackItalic.ttf" id="2_cond_black"]
[ext_resource type="FontFile" path="res://ui/fonts/BarlowCondensed-ExtraBoldItalic.ttf" id="3_cond_xbold"]
[ext_resource type="FontFile" path="res://ui/fonts/Barlow-SemiBold.ttf" id="4_body"]
[ext_resource type="FontFile" path="res://ui/fonts/DelaGothicOne-Regular.ttf" id="5_kana"]

